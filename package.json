{
  "name": "pvz-animator",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based animation studio for Plants vs. Zombies: open main.pak, edit PopCap reanim animations and particle effects, and sync sounds.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7"
  }
}
